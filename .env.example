# Copy to .env and change the values. .env is loaded automatically on start.

PORT=3000

# OAuth clients, API keys and Basic logins are created in the UI (Credentials page).
# Default OAuth access-token lifetime in seconds; each OAuth client can override it.
TOKEN_TTL_SECONDS=3600

# Rate limit on private collections, per credential. Exceeding it returns 429 + Retry-After.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Inventory size. 450 VMs at page_size=200 gives 3 pages.
VM_COUNT=450
# Seed for the deterministic data generator (same seed = same data).
DATA_SEED=20261119

# MongoDB. If unset or unreachable the server falls back to in-memory storage
# (data resets on restart). Set REQUIRE_MONGODB=true to fail instead of falling back.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cloud_inventory_mock
REQUIRE_MONGODB=false
